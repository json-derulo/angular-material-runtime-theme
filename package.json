{
  "name": "angular-material-runtime-theme",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "pnpm run /^build:/",
    "build:lib": "ng build lib",
    "build:demo": "ng build demo",
    "pretest": "pnpm build:lib",
    "test": "pnpm run /^test:/",
    "test:lib": "ng test lib",
    "test:demo": "ng test demo",
    "test:compat-build": "pnpm -r run build",
    "test:compat-test": "pnpm -r run test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "pnpm --dir projects/lib exec release-it"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.22",
    "@angular/router": "21.2.22",
    "@material/material-color-utilities": "0.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.22",
    "@release-it/bumper": "8.0.0",
    "@release-it/conventional-changelog": "12.0.0",
    "jsdom": "30.0.1",
    "ng-packagr": "21.2.7",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "release-it": "21.0.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.25.0"
}
