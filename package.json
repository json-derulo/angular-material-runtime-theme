{
  "name": "angular-material-runtime-theme",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "pnpm run /^build:/",
    "build:lib": "ng build lib",
    "build:demo": "ng build demo",
    "pretest": "pnpm build:lib",
    "test": "pnpm run /^test:/",
    "test:lib": "ng test lib",
    "test:demo": "ng test demo",
    "test:compat-build": "pnpm -r run build",
    "test:compat-test": "pnpm -r run test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "pnpm --dir projects/lib exec release-it"
  },
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/material": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@material/material-color-utilities": "0.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.6",
    "@release-it/bumper": "8.0.0",
    "@release-it/conventional-changelog": "12.0.0",
    "jsdom": "30.0.1",
    "ng-packagr": "22.1.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "release-it": "21.0.2",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.4.0"
}
