{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "group:allNonMajor"],
  schedule: ["before 4am on sunday", "before 4am on monday"],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchPackageNames: ["ng-packagr", "@angular/{/,}**"],
      matchUpdateTypes: ["major"],
      groupName: "angular",
    },
    {
      matchFileNames: ["tests/v21/package.json"],
      matchPackageNames: ["@angular/{/,}**"],
      allowedVersions: "<=21",
    },
    {
      matchFileNames: ["tests/v22/package.json"],
      matchPackageNames: ["@angular/{/,}**"],
      allowedVersions: "<=22",
    },
  ],
}
