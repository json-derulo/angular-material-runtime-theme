{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "schedule:weekends",
    "schedule:earlyMondays",
    "group:allNonMajor",
  ],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchPackageNames: ["ng-packagr", "@angular/{/,}**"],
      matchUpdateTypes: ["major"],
      groupName: "angular",
    },
    {
      matchFileNames: ["tests/v21/package.json"],
      matchPackageNames: ["@angular/{/,}**"],
      allowedVersions: "<=21",
    },
    {
      matchFileNames: ["tests/v22/package.json"],
      matchPackageNames: ["@angular/{/,}**"],
      allowedVersions: "<=22",
    },
  ],
}
