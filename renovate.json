{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["ng-packagr", "@angular/{/,}**"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "angular"
    }
  ]
}
